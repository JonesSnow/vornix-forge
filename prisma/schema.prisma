// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id              String   @id @default(cuid())
  clerkId         String   @unique
  firstName       String?
  lastName        String?
  goal            String?
  experienceLevel String?
  markets         String[] @default([])
  dailyTime       String?
  riskTolerance   String?
  onboardingDone  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  simulatorPortfolio SimulatorPortfolio?
  simulatorTrades    SimulatorTrade[]
  journals           Journal[]
}

model Assessment {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  score     Int
  level     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String
  level       Int
  order       Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  modules     Module[]
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String
  order       Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  course      Course   @relation(fields: [courseId], references: [id])
  lessons     Lesson[]
  progress    Progress[]
}

model Lesson {
  id          String   @id @default(cuid())
  moduleId    String
  title       String
  content     String   @db.Text
  type        String
  order       Int
  duration    Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  module      Module   @relation(fields: [moduleId], references: [id])
}

model Progress {
  id         String    @id @default(cuid())
  clerkId    String
  moduleId   String
  completed  Boolean   @default(false)
  completedAt DateTime?
  module     Module    @relation(fields: [moduleId], references: [id])

  @@unique([clerkId, moduleId])
}

model SimulatorPortfolio {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  balance   Float    @default(500000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile   Profile  @relation(fields: [clerkId], references: [clerkId])
  trades    SimulatorTrade[]
}

model SimulatorTrade {
  id          String    @id @default(cuid())
  clerkId     String
  symbol      String
  side        String
  quantity    Float
  entryPrice  Float
  exitPrice   Float?
  stopLoss    Float?
  takeProfit  Float?
  status      String    @default("open")
  pnl         Float?
  openedAt    DateTime  @default(now())
  closedAt    DateTime?
  profile     Profile   @relation(fields: [clerkId], references: [clerkId])
  portfolio   SimulatorPortfolio @relation(fields: [portfolioId], references: [id])
  portfolioId String
}

model Journal {
  id            String   @id @default(cuid())
  clerkId       String
  title         String
  content       String   @db.Text
  mood          String
  aiFeedback    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  profile       Profile  @relation(fields: [clerkId], references: [clerkId])
}
